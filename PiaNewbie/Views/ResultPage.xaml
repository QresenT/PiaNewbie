<UserControl x:Class="PiaNewbie.Views.ResultPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource BgDarkBrush}">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}"/>
        <TextBlock Text="{Binding ModeText}" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,16"/>
        <TextBlock Text="{Binding DetailText}" FontSize="16" HorizontalAlignment="Center"
                   TextAlignment="Center" LineHeight="28" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding AccuracyText}" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,32"/>
        <Button Content="다시 하기" Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding RetrySetupCommand}" MinWidth="200"/>
        <Button Content="메인으로" Style="{StaticResource SecondaryButtonStyle}"
                Command="{Binding GoMainCommand}" MinWidth="200"/>
    </StackPanel>
</UserControl>
