<Window x:Class="PiaNewbie.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="사용법"
        Width="520"
        Height="560"
        MinWidth="400"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0A0E1A"
        Foreground="#E5E7EB">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PiaNewbie 사용법" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="시작하기" FontSize="16" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#CBD5E1" Margin="0,0,0,16"
                           Text="「시작」을 누르면 MIDI 설정 화면으로 이동합니다. MIDI 파일을 선택하고 연주할 멜로디 트랙과 모드를 고른 뒤 플레이를 시작하세요."/>

                <TextBlock Text="MIDI 설정" FontSize="16" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#CBD5E1" Margin="0,0,0,16"
                           Text="· MIDI 파일을 불러오면 BPM, 길이 등이 표시됩니다.&#x0a;· 트랙 목록에서 멜로디로 연습할 트랙을 선택하세요.&#x0a;· 가이드 노트 색상은 피아노 롤에서 강조되는 색입니다."/>

                <TextBlock Text="스크롤 속도" FontSize="16" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#CBD5E1" Margin="0,0,0,16"
                           Text="· MIDI 설정에서 스크롤 속도(1×~2×)를 고를 수 있습니다.&#x0a;· 음악·반주 재생 속도는 바뀌지 않으며, 화면에서의 노트 이동만 빨라지거나 느려집니다."/>

                <TextBlock Text="Flow / Rhythm 모드" FontSize="16" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#CBD5E1" Margin="0,0,0,16"
                           Text="· Flow: 반주 없이 가이드 노트만 소리가 납니다. 노트가 히트 라인에 닿을 때 입력하며, 한 번에 한 음씩 진행합니다.&#x0a;· Rhythm: MIDI 반주가 끝까지 재생됩니다. 타이밍에 맞춰 입력하고 HIT/MISS 판정이 키뷰어 위에 표시됩니다."/>

                <TextBlock Text="키 입력" FontSize="16" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#CBD5E1" Margin="0,0,0,16"
                           Text="· 홈 행 키 A S D F G H J K L ; ' 만 사용합니다.&#x0a;· 첫 입력 전까지는 모든 키를 사용할 수 있습니다.&#x0a;· 이후 노트는 이전 음보다 높으면 오른쪽, 낮으면 왼쪽 키가 입력 가능합니다.&#x0a;· 키뷰어에 강조된 키가 지금 눌러도 되는 키입니다."/>

                <TextBlock Text="연습 중 단축키" FontSize="16" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#CBD5E1" Margin="0,0,0,16"
                           Text="· ESC — MIDI 설정 화면으로 나가기&#x0a;· F5 — 즉시 재시작 (프리롤부터 다시)"/>

                <TextBlock Text="판정 (Rhythm)" FontSize="16" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#CBD5E1"
                           Text="· 시작 전 카운트다운은 키뷰어 위 배너에 표시됩니다.&#x0a;· 첫 노트는 아무 홈 행 키나 누르면 HIT입니다 (타이밍·방향 검사 없음).&#x0a;· 두 번째 노트부터는 타이밍과 방향에 맞는 키만 HIT입니다.&#x0a;· MISS가 많으면 F5로 다시 플레이해 보세요."/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="닫기" Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Right" Margin="0,16,0,0" IsDefault="True"
                Click="OnCloseClick" MinWidth="100"/>
    </Grid>
</Window>
