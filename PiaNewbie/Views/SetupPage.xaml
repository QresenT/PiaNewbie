<UserControl x:Class="PiaNewbie.Views.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource BgDarkBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="MIDI 설정" Style="{StaticResource PageTitleStyle}" Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="MIDI 파일 선택" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding BrowseMidiCommand}"/>
                <Button Content="MuseScore에서 찾기" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenMusescoreCommand}" Margin="0,8,8,8"/>
                <TextBlock Text="{Binding SelectedFileName}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="MIDI 파일이 없다면 MuseScore 등에서 악보·MIDI를 검색해 받을 수 있습니다."
                       FontSize="12" Foreground="#9CA3AF" Margin="8,0,0,0"/>
            <TextBlock Text="{Binding SongAnalysisSummary}" Margin="0,8,0,0"
                       FontSize="14" Foreground="#93C5FD" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Tracks}"
                  SelectedItem="{Binding SelectedTrack}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="#111827"
                  Foreground="White"
                  BorderBrush="#2A3348"
                  RowBackground="#111827"
                  AlternatingRowBackground="#151C2E"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2A3348"/>
                    <Setter Property="Foreground" Value="#F3F4F6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      RecognizesAccessKey="True"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding TrackIndex}" Width="40"/>
                <DataGridTextColumn Header="트랙 이름" Binding="{Binding TrackName}" Width="200"/>
                <DataGridTextColumn Header="음표 수" Binding="{Binding NoteCount}" Width="80"/>
                <DataGridTextColumn Header="최저" Binding="{Binding MinPitch}" Width="60"/>
                <DataGridTextColumn Header="최고" Binding="{Binding MaxPitch}" Width="60"/>
                <DataGridTextColumn Header="채널" Binding="{Binding ChannelsDisplay}" Width="80"/>
            </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="1"
                       Text="{Binding ModeHintMessage}"
                       Margin="0,12,0,0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#FCD34D"
                       TextWrapping="Wrap"
                       VerticalAlignment="Bottom"/>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="가이드 노트 색" FontSize="14" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                <TextBlock Text="#" VerticalAlignment="Center" Foreground="#9CA3AF" Margin="0,0,4,0"/>
                <TextBox Text="{Binding GuideNoteColorHex, UpdateSourceTrigger=PropertyChanged}"
                         Width="88" MaxLength="7" VerticalContentAlignment="Center"
                         Background="#0F172A" Foreground="#E5E7EB" BorderBrush="#2A3348" Padding="6,4"/>
                <Border Width="48" Height="24" CornerRadius="4" BorderBrush="#64748B" BorderThickness="1"
                        Background="{Binding GuideColorPreviewBrush}" Margin="10,0,0,0"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding PaletteColors}" MaxWidth="528" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Height="24" Width="40" Margin="1" Padding="0" Cursor="Hand"
                                Command="{Binding DataContext.SelectGuideColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Hex}"
                                ToolTip="{Binding Name}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Swatch" Background="{Binding Hex}" CornerRadius="4"
                                            BorderBrush="#475569" BorderThickness="1"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Swatch" Property="BorderBrush" Value="#E2E8F0"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Swatch" Property="BorderBrush" Value="#FFFFFF"/>
                                            <Setter TargetName="Swatch" Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
            <RadioButton Content="Flow Mode" IsChecked="{Binding IsFlowMode}" Margin="0,0,12,0"/>
            <RadioButton Content="Rhythm Mode" IsChecked="{Binding IsRhythmMode}"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <TextBlock Text="스크롤 속도" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="노트 낙하 속도 (음악 속도와 무관)" FontSize="12"
                       Foreground="#9CA3AF" Margin="0,2,0,8"/>
            <ItemsControl ItemsSource="{Binding ScrollSpeedChoices}" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Height="28" MinWidth="52" Margin="0,0,6,0"
                                Padding="10,0" Cursor="Hand"
                                Command="{Binding DataContext.SelectScrollSpeedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Value}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Chip" Background="#0F172A"
                                            BorderBrush="#475569" BorderThickness="1"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          TextElement.Foreground="#CBD5E1"
                                                          TextElement.FontSize="13"
                                                          TextElement.FontWeight="SemiBold"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="#111C33"/>
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="#6366F1"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="#1E293B"/>
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="#FFFFFF"/>
                                            <Setter TargetName="Chip" Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="플레이 시작" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding StartPracticeCommand}" IsEnabled="{Binding CanStart}"/>
            <Button Content="메인으로" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding BackCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
